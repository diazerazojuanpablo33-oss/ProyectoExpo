37em; --x-hxtmnb: 0.0137em;">2/26/2026</span></div></div><div class="x1n2onr6"><div tabindex="-1" class="" role="row"><div tabindex="-1" class="_amjv xscbp6u" data-id="true_593969781209@c.us_AC70BA8DAC7A4AE5D3D2C668DB97BEB5_out"><div class="x78zum5 xdt5ytf" data-virtualized="false"><div class=""><div class="message-out focusable-list-item _amjy _amjz _amjw x1klvx2g xahtqtb"><span class=""></span><div class="_amk4 false _amkd _amk5 false"><span aria-hidden="true" data-icon="tail-out" class="_amk7"><svg viewBox="0 0 8 13" height="13" width="8" preserveAspectRatio="xMidYMid meet" class="" version="1.1" x="0px" y="0px" enable-background="new 0 0 8 13"><title>tail-out</title><path opacity="0.13" d="M5.188,1H0v11.193l6.467-8.625 C7.526,2.156,6.958,1,5.188,1z"></path><path fill="currentColor" d="M5.188,0H0v11.193l6.467-8.625C7.526,1.156,6.958,0,5.188,0z"></path></svg></span><div class="_amk6 _amlo false false"><span aria-label="Tú:"></span><div><div class="x9f619 x1hx0egp x1yrsyyn xizg8k xu9hqtb xwib8y2"><div class="copyable-text" data-pre-plain-text="[7:52 PM, 2/26/2026] 😼: "><div class="_akbu x6ikm8r x10wlt62"><span data-testid="selectable-text" dir="ltr" class="x1f6kntn xjb2p0i x8r4c90 xo1l8bm x1ic7a3i x12xpedu _ao3e _aupe copyable-text" style="min-height: 0px;"><span class="x1lliihq">La carrera de sacos consiste en que cada participante se mete dentro de un saco (generalmente de yute o tela resistente) y debe avanzar saltando hasta llegar a una meta.
</span><span class="x1lliihq"><img crossorigin="anonymous" alt="📌" draggable="false" data-testid="selectable-text" class="b73 emoji wa  _ao3e _aupe copyable-text" data-plain-text="📌" tabindex="-1" src="data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7" style="background-position: -40px -60px;"> ¿Cómo se juega?
</span><span class="x1lliihq">Cada jugador entra en un saco sujetándolo con las manos.
</span><span class="x1lliihq">Se colocan todos en una línea de salida.
</span><span class="x1lliihq">Cuando dan la señal, empiezan a saltar hacia adelante sin salirse del saco.
</span><span class="">Gana el que llega primero a la meta sin caerse.</span></span><span class=""><span class="x3nfvp2 xxymvpz xlshs6z xqtp20y xexx8yu x1uc92m x18d9i69 x181vq82 x12lo8hy x152skdk" aria-hidden="true"><span class="x1c4vz4f x2lah0s xn6xy2s"></span><span class="x1c4vz4f x2lah0s">7:52 PM</span></span></span></div></div><div class="x1n2onr6 x1n327nk x18mqm2i xhsvlbd x14z9mp xz62fqu x1wbi8v6"><div class="x1bvqhpb xx3o462 xuxw1ft x78zum5 x6s0dn4 x12lo8hy x152skdk"><span class="x1rg5ohu x16dsc37" dir="auto"><span class="x193iq5w xeuugli x13faqbe x1vvkbs xt0psk2 x1fj9vlw xhslqc4 x1hx0egp x1pg5gke xjb2p0i xo1l8bm xl2ypbo x1ic7a3i" style="--x-fontSize: 12px; --x-lineHeight: 8.5313px;">7:52 PM</span></span><div class="xhslqc4 x1rg5ohu x7phf20"><span aria-hidden="false" aria-label=" Leído " data-icon="msg-dblcheck" class="x1rv0e52"><svg viewBox="0 0 16 11" height="11" width="16" preserveAspectRatio="xMidYMid meet" class="" fill="none"><title>msg-dblcheck</title><path d="M11.0714 0.652832C10.991 0.585124 10.8894 0.55127 10.7667 0.55127C10.6186 0.55127 10.4916 0.610514 10.3858 0.729004L4.19688 8.36523L1.79112 6.09277C1.7488 6.04622 1.69802 6.01025 1.63877 5.98486C1.57953 5.95947 1.51817 5.94678 1.45469 5.94678C1.32351 5.94678 1.20925 5.99544 1.11192 6.09277L0.800883 6.40381C0.707784 6.49268 0.661235 6.60482 0.661235 6.74023C0.661235 6.87565 0.707784 6.98991 0.800883 7.08301L3.79698 10.0791C3.94509 10.2145 4.11224 10.2822 4.29844 10.2822C4.40424 10.2822 4.5058 10.259 4.60313 10.2124C4.70046 10.1659 4.78086 10.1003 4.84434 10.0156L11.4903 1.59863C11.5623 1.5013 11.5982 1.40186 11.5982 1.30029C11.5982 1.14372 11.5348 1.01888 11.4078 0.925781L11.0714 0.652832ZM8.6212 8.32715C8.43077 8.20866 8.2488 8.09017 8.0753 7.97168C7.99489 7.89128 7.8891 7.85107 7.75791 7.85107C7.6098 7.85107 7.4892 7.90397 7.3961 8.00977L7.10411 8.33984C7.01947 8.43717 6.97715 8.54508 6.97715 8.66357C6.97715 8.79476 7.0237 8.90902 7.1168 9.00635L8.1959 10.0791C8.33132 10.2145 8.49636 10.2822 8.691